@layout()
  <div class="mx-auto max-w-(--breakpoint-2xl) p-4 pb-20 md:p-6 md:pb-6">
    <div class="space-y-6">

      <div
        class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-white/[0.03]"
      >

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h1 class="text-xl font-semibold text-gray-800 dark:text-white">
              Conflict Detected
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Review the differences before continuing
            </p>
          </div>

          <span
            class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-medium text-yellow-700 dark:bg-yellow-500/10 dark:text-yellow-400"
          >
            Needs Attention
        </span>
        </div>

        <!-- Diff Grid -->
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">

          <!-- Added -->
          <div
            class="rounded-xl border border-green-200 bg-green-50/40 p-4 dark:border-green-800 dark:bg-green-500/5"
          >
            <h2 class="mb-3 text-sm font-semibold text-green-700 dark:text-green-400">
              Added
            </h2>

            <div class="max-h-64 space-y-1 overflow-y-auto font-mono text-sm">
              @each(add in added)
                <p
                  class="rounded px-2 py-1 text-green-600 hover:bg-green-100/60 dark:text-green-400 dark:hover:bg-green-500/10"
                >
                  + {{ add }}
                </p>
              @end
            </div>
          </div>

          <!-- Removed -->
          <div class="rounded-xl border border-red-200 bg-red-50/40 p-4 dark:border-red-800 dark:bg-red-500/5">
            <h2 class="mb-3 text-sm font-semibold text-red-700 dark:text-red-400">
              Removed
            </h2>

            <div class="max-h-64 space-y-1 overflow-y-auto font-mono text-sm">
              @each(remove in removed)
                <p
                  class="rounded px-2 py-1 text-red-600 hover:bg-red-100/60 dark:text-red-400 dark:hover:bg-red-500/10"
                >
                  - {{ remove }}
                </p>
              @end
            </div>
          </div>

        </div>

        <!-- Actions -->
        <div
          class="mt-8 flex items-center justify-end gap-3 border-t border-gray-200 pt-6 dark:border-gray-800"
        >

          @form({ route: 'baplies.cancel', method: 'POST' })
            <input type="hidden" name="cacheId" value={{cacheId}}>
            <button
              type="submit"
              class="rounded-xl border border-gray-300 px-6 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/5"
            >
              Cancel
          </button>
          @end
          
          @form({ route: 'baplies.confirm', method: 'POST' })
            <input type="hidden" name="cacheId" value={{cacheId}}>
            <button
              type="submit"
              class="rounded-xl bg-success-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-success-700"
            >
              Merge Changes
          </button>
          @end
          
        </div>

      </div>

    </div>
  </div>
@end
