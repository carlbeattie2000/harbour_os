@layout()
<div class="mx-auto max-w-screen-2xl p-4 md:p-6 2xl:p-10">

  {{-- Page Header --}}
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-title-md2 font-semibold text-black dark:text-white">
        Stowage Plan
      </h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Voyage {{ portCall.voyageNumber }} &mdash; Vessel {{ portCall.vesselId }}
      </p>
    </div>

    {{-- Status Badge --}}
    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium {{ portCall.status === 'pending' ? 'bg-warning/10 text-warning' : portCall.status === 'active' ? 'bg-success/10 text-success' : 'bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300' }}">
      <span class="inline-block h-2 w-2 rounded-full {{ portCall.status === 'pending' ? 'bg-warning' : portCall.status === 'active' ? 'bg-success' : 'bg-gray-400' }}">
      </span>
      {{ portCall.status.charAt(0).toUpperCase() + portCall.status.slice(1) }}
    </span>
  </div>

  {{-- Port Call Summary Cards --}}
  <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4">

    <div class="rounded-[10px] border border-stroke bg-white p-4 shadow-sm dark:border-dark-3 dark:bg-gray-dark">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Purpose</p>
      <p class="mt-1 text-sm font-semibold text-black dark:text-white">{{ portCall.purpose }}</p>
    </div>

    <div class="rounded-[10px] border border-stroke bg-white p-4 shadow-sm dark:border-dark-3 dark:bg-gray-dark">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Priority</p>
      <p class="mt-1 text-sm font-semibold text-black dark:text-white capitalize">{{ portCall.priority }}</p>
    </div>

    <div class="rounded-[10px] border border-stroke bg-white p-4 shadow-sm dark:border-dark-3 dark:bg-gray-dark">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">ETA</p>
      <p class="mt-1 text-sm font-semibold text-black dark:text-white">{{ new Date(portCall.eta).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) }}</p>
    </div>

    <div class="rounded-[10px] border border-stroke bg-white p-4 shadow-sm dark:border-dark-3 dark:bg-gray-dark">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">ETD</p>
      <p class="mt-1 text-sm font-semibold text-black dark:text-white">{{ new Date(portCall.etd).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) }}</p>
    </div>

  </div>

  {{-- Stowage Plans Table with Alpine search --}}
  <div
    class="rounded-[10px] border border-stroke bg-white shadow-sm dark:border-dark-3 dark:bg-gray-dark"
    x-data="{
      search: '',
      plans: {{ JSON.stringify(stowagePlans) }},
      get filtered() {
        if (!this.search.trim()) return this.plans
        const q = this.search.toLowerCase().trim()
        return this.plans.filter(p => p.containerId.toLowerCase().includes(q))
      }
    }"
  >

    {{-- Table Header --}}
    <div class="flex flex-col gap-3 border-b border-stroke px-5 py-4 dark:border-dark-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="font-semibold text-black dark:text-white">Container Assignments</h3>
        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
          {{ stowagePlans.length }} container{{ stowagePlans.length !== 1 ? 's' : '' }} planned
        </p>
      </div>

      {{-- Search Input --}}
      <div class="relative w-full sm:w-64">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
          <svg class="h-4 w-4 fill-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd"/>
          </svg>
        </span>
        <input
          type="text"
          x-model="search"
          placeholder="Search container ID…"
          class="w-full rounded-lg border border-stroke bg-transparent py-2 pl-9 pr-4 text-sm text-black outline-none transition focus:border-primary dark:border-dark-3 dark:text-white dark:focus:border-primary"
        />
        <button
          x-show="search.length > 0"
          x-on:click="search = ''"
          class="absolute inset-y-0 right-3 flex items-center text-gray-400 hover:text-gray-600"
          aria-label="Clear search"
        >
          <svg class="h-3.5 w-3.5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
          </svg>
        </button>
      </div>
    </div>

    {{-- Table --}}
    <div class="overflow-x-auto">
      <table class="w-full table-auto">
        <thead>
          <tr class="border-b border-stroke bg-gray-2 text-left dark:border-dark-3 dark:bg-meta-4">
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Container ID</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Operation</th>
            <th class="px-5 py-3.5 text-center text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Bay</th>
            <th class="px-5 py-3.5 text-center text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Row</th>
            <th class="px-5 py-3.5 text-center text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Tier</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Position</th>
          </tr>
        </thead>
        <tbody>

          {{-- Empty state (no results from search) --}}
          <template x-if="filtered.length === 0">
            <tr>
              <td colspan="6" class="px-5 py-12 text-center">
                <div class="flex flex-col items-center gap-2 text-gray-400 dark:text-gray-500">
                  <svg class="h-8 w-8 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z" />
                  </svg>
                  <p class="text-sm font-medium" x-text="search ? `No containers matching '${search}'` : 'No stowage plans found'"></p>
                </div>
              </td>
            </tr>
          </template>

          {{-- Rows --}}
          <template x-for="(plan, index) in filtered" :key="plan.id">
            <tr
              class="border-b border-stroke dark:border-dark-3 hover:bg-gray-2/50 dark:hover:bg-meta-4/30 transition-colors"
              :class="index % 2 === 0 ? '' : 'bg-gray-2/30 dark:bg-meta-4/10'"
            >
              {{-- Container ID --}}
              <td class="px-5 py-3.5">
                <span
                  class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2.5 py-1 font-mono text-xs font-semibold text-black dark:bg-meta-4 dark:text-white"
                  x-text="plan.containerId"
                ></span>
              </td>

              {{-- Operation badge --}}
              <td class="px-5 py-3.5">
                <span
                  class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium"
                  :class="plan.operation === 'LOAD'
                    ? 'bg-success/10 text-success'
                    : 'bg-danger/10 text-danger'"
                >
                  <svg class="h-3 w-3 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                    <template x-if="plan.operation === 'LOAD'">
                      <path fill-rule="evenodd" d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z" clip-rule="evenodd"/>
                    </template>
                    <template x-if="plan.operation !== 'LOAD'">
                      <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z" clip-rule="evenodd"/>
                    </template>
                  </svg>
                  <span x-text="plan.operation"></span>
                </span>
              </td>

              {{-- Bay --}}
              <td class="px-5 py-3.5 text-center">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-stroke bg-white text-sm font-semibold text-black dark:border-dark-3 dark:bg-gray-dark dark:text-white" x-text="plan.bay"></span>
              </td>

              {{-- Row --}}
              <td class="px-5 py-3.5 text-center">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-stroke bg-white text-sm font-semibold text-black dark:border-dark-3 dark:bg-gray-dark dark:text-white" x-text="plan.row"></span>
              </td>

              {{-- Tier --}}
              <td class="px-5 py-3.5 text-center">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-stroke bg-white text-sm font-semibold text-black dark:border-dark-3 dark:bg-gray-dark dark:text-white" x-text="plan.tier"></span>
              </td>

              {{-- Composite position --}}
              <td class="px-5 py-3.5">
                <span
                  class="font-mono text-xs text-gray-500 dark:text-gray-400"
                  x-text="`B${String(plan.bay).padStart(2,'0')} / R${String(plan.row).padStart(2,'0')} / T${String(plan.tier).padStart(2,'0')}`"
                ></span>
              </td>
            </tr>
          </template>

        </tbody>
      </table>
    </div>

    {{-- Footer count --}}
    <div class="border-t border-stroke px-5 py-3 dark:border-dark-3">
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Showing <span class="font-medium text-black dark:text-white" x-text="filtered.length"></span>
        of <span class="font-medium text-black dark:text-white">{{ stowagePlans.length }}</span> containers
      </p>
    </div>

  </div>

</div>
@end